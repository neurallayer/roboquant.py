// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "run unit test",
    "command": "uv run python -m unittest discover -s tests/unit",
    "show_command": false,
  },
  {
    "label": "run ty",
    "command": "uvx ty check",
    "show_command": false,
  },
  {
    "label": "run Jupyter Book",
    "command": "./bin/run_jupyter_book.sh",
    "show_command": false
  },
  {
    "label": "run pyrefly",
    "command": "uvx pyrefly check",
    "show_command": false,
  },
  {
    "label": "fix imports",
    "command": "uvx ruff check --select I --fix $ZED_FILE",
    "show_command": false,
  },
  {
    "label": "uv sync",
    "command": "uv sync --all-extras --dev",
    "show_command": false,
  },
  {
    "label": "verify",
    "command": "uvx ruff check && uvx ty check && uvx pyrefly check && uv run python -m unittest discover -s tests/unit",
    "show_command": false,
  },
  {
    "label": "uv ruff",
    "command": "uvx ruff check",
    "show_command": false,
  },
]
