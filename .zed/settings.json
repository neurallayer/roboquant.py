{
  "file_scan_exclusions": [
    "**/.venv",
    "**/.vscode",
    "**/__pycache__",
    "dist/",
    "**/*.egg-info",
    "**/.DS_Store",
    ".idea",
    "**/.*_cache",
    "**/.git"
  ],
  "languages": {
    "Python": {
      "language_servers": ["ruff", "pyrefly", "!ty", "!pyright"],
      "tasks": {
        "variables": {
          "TEST_RUNNER": "unittest",
        },
      },
    },
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python",
        },
      },
    },
    "pyrefly": {
      "settings": {
        "python": {
          "pythonPath": ".venv/bin/python",
        },
      },
    },
  },
}
