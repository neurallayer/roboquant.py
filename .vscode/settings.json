{
    "cSpell.words": [
        "annualize",
        "BBANDS",
        "BTCUSD",
        "bybit",
        "CCTX",
        "ccxt",
        "conid",
        "d'être",
        "dataframe",
        "dotenv",
        "dtype",
        "eurofxref",
        "Forex",
        "hstack",
        "ibind",
        "ibkr",
        "isinstance",
        "itertools",
        "ndigits",
        "numpy",
        "ohlcv",
        "optim",
        "pnlmetric",
        "prettytable",
        "pydatetime",
        "pyplot",
        "roboquant",
        "stooq",
        "Tensorboard",
        "timeframes",
        "twinx",
        "zorder"
    ],
    "python.testing.unittestArgs": [
        "-v",
        "-p",
        "test_*.py"
    ],
    "__python.testing.unittestArgs": [
        "-v",
        "-s",
        "./tests/unit",
        "-p",
        "test_*.py"
    ],
    "__python.testing.pytestArgs": [
        "--ignore=tests/integration",
        "--ignore=tests/performance"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.*": true,
        "**/*.egg-info": true
    }
}
